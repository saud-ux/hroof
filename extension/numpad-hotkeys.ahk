#Requires AutoHotkey v2.0
#SingleInstance Force

; جسر النم باد لاختصارات إضافة "حروف — اختصارات البَزّر".
;
; تضغط رقمًا واحدًا من لوحة الأرقام (Numpad)، والسكربت يحوّله إلى
; Ctrl+Shift+رقم — وهو الاختصار العام (global) الذي تلتقطه الإضافة على مستوى
; النظام، فيصل للمتصفح مهما كانت النافذة النشطة (حتى وأنت داخل اللعبة).
;
; الطريقة:
;   1) ثبّت AutoHotkey v2 من https://autohotkey.com
;   2) شغّل هذا الملف بالنقر المزدوج (يظهر أيقونة في شريط المهام).
;   3) تأكد أن اختصارات الإضافة على نطاق Global في chrome://extensions/shortcuts
;      وأن مفاتيحها هي Ctrl+Shift+1..4 (الافتراضي).

; ---- NumLock مُفعّل (الوضع الطبيعي للأرقام) ----
Numpad1:: Send("^+1")   ; تجهيز البَزّر
Numpad2:: Send("^+2")   ; إلغاء/إيقاف الجولة
Numpad3:: Send("^+3")   ; الجولة/السؤال التالي
Numpad4:: Send("^+4")   ; احتساب نقطة

; ---- NumLock مُطفأ (نفس الأزرار برموزها البديلة) ----
NumpadEnd::  Send("^+1")
NumpadDown:: Send("^+2")
NumpadPgDn:: Send("^+3")
NumpadLeft:: Send("^+4")

; مثال للتوسّع: لو عيّنت مفاتيح لبقية الأوامر (الإجابة/الصعوبة/المؤقّت) في
; صفحة الاختصارات، أضِف أسطرًا مماثلة، مثلًا:
;   Numpad5:: Send("^+5")   ; بعد ربط Ctrl+Shift+5 بأمر إظهار الإجابة
